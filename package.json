{
  "name": "docvault",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preparar": "tsx bench/preparar.ts",
    "banco": "tsx bench/correr.ts",
    "calificar": "tsx bench/calificar.ts",
    "informe": "tsx bench/informe.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "app": "npm run dev -w @docvault/web",
    "app:construir": "npm run build -w @docvault/web",
    "e2e": "npm run e2e -w @docvault/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@sqlite.org/sqlite-wasm": "^3.50.4-build1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1"
  }
}
